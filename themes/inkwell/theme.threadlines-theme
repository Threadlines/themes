    "script": "(() => {\n  // Warm paper with iron-gall ink washes creeping in from the margins.\n  // Washes advance and recede along the paper's grain; fresh drops land\n  // blue-black and dry to sepia (one lands when a turn finishes).\n  const W = 640, H = 400, N = W * H, SC = W / 640;\n  const ANGN = 512, TAU = Math.PI * 2, GROUPS = 2, PS = 1000;\n  const L0 = 0.62, OFFA = 0.07, OFFB = 0.03, BREATH = 0.022, WKL = 0.02;\n\n  const parse = (c, fb) => {\n    if (typeof c !== \"string\") return fb;\n    let m = /^#([0-9a-f]{3,8})$/i.exec(c.trim());\n    if (m) {\n      let h = m[1];\n      if (h.length < 6) h = h.split(\"\").map((x) => x + x).join(\"\");\n      return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];\n    }\n    m = /rgba?\\(([^)]+)\\)/i.exec(c);\n    if (m) {\n      const p = m[1].split(/[\\s,\\/]+/).filter(Boolean).map(parseFloat);\n      if (p.length >= 3) return p.slice(0, 3);\n    }\n    return fb;\n  };\n  const pick = (pal, names, fb) => {\n    if (pal) for (const n of names) if (pal[n]) return parse(pal[n], fb);\n    return fb;\n  };\n  const mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\n  const pack = (r, g, b, a) => ((a << 24) | ((b & 255) << 16) | ((g & 255) << 8) | (r & 255)) >>> 0;\n  const ss = (e0, e1, x) => {\n    let t = (x - e0) / (e1 - e0);\n    t = t < 0 ? 0 : t > 1 ? 1 : t;\n    return t * t * (3 - 2 * t);\n  };\n  const rng = (seed) => () => {\n    seed = (seed + 0x6d2b79f5) | 0;\n    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n\n  // the calm middle never takes ink, so each row skips its middle span\n  const T4 = 0.55 ** 4;\n  const spanLo = new Int32Array(H), spanHi = new Int32Array(H);\n  for (let y = 0; y < H; y++) {\n    const dy = Math.abs(y / (H - 1) - 0.5) * 2 * 0.9, rem = T4 - dy * dy * dy * dy;\n    if (rem <= 0) continue;\n    const hw = Math.sqrt(Math.sqrt(rem)) / 2;\n    spanLo[y] = Math.ceil((0.5 - hw) * (W - 1)) + 1;\n    spanHi[y] = Math.max(spanLo[y], Math.floor((0.5 + hw) * (W - 1)));\n  }\n\n  // a random lattice, sampled with smoothstep-bilinear interpolation\n  function lattice(cell, rand) {\n    const gw = Math.ceil(W / cell) + 2, gh = Math.ceil(H / cell) + 2;\n    const g = new Float32Array(gw * gh);\n    for (let k = 0; k < g.length; k++) g[k] = rand();\n    const ix = new Int32Array(W), fx = new Float32Array(W);\n    for (let x = 0; x < W; x++) {\n      const q = x / cell, i = q | 0, f = q - i;\n      ix[x] = i;\n      fx[x] = f * f * (3 - 2 * f);\n    }\n    return { g, gw, gh, ix, fx, cell };\n  }\n  function sample(L, x, y) {\n    const qx = x / L.cell, qy = y / L.cell, i = qx | 0, j = qy | 0;\n    let fx = qx - i, fy = qy - j;\n    fx = fx * fx * (3 - 2 * fx);\n    fy = fy * fy * (3 - 2 * fy);\n    const g = L.g, r0 = j * L.gw + i, r1 = r0 + L.gw;\n    const a = g[r0] + (g[r0 + 1] - g[r0]) * fx, b = g[r1] + (g[r1 + 1] - g[r1]) * fx;\n    return a + (b - a) * fy;\n  }\n\n  const hash = (x, y, s) => {\n    let h = (Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(s, 1442695041)) | 0;\n    h = Math.imul(h ^ (h >>> 13), 1274126177);\n    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n  };\n  const vnoise = (x, y, cell, s) => {\n    const gx = x / cell, gy = y / cell, ix = Math.floor(gx), iy = Math.floor(gy);\n    let fx = gx - ix, fy = gy - iy;\n    fx = fx * fx * (3 - 2 * fx);\n    fy = fy * fy * (3 - 2 * fy);\n    const a = hash(ix, iy, s), b = hash(ix + 1, iy, s), c = hash(ix, iy + 1, s), d = hash(ix + 1, iy + 1, s);\n    return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;\n  };\n\n  // 0 in the calm middle, rising to 1 at the rim of the sheet\n  const edge = (u, v) => {\n    const dx = Math.abs(u - 0.5) * 2, dy = Math.abs(v - 0.5) * 2 * 0.9;\n    return ss(0.55, 1.25, Math.pow(dx * dx * dx * dx + dy * dy * dy * dy, 0.25));\n  };\n\n  let Pq, ang, gA, gPix, act, groupAt, mask, smin, LUTN, offBase = 0;\n  let lutA, lutPix;\n  const offq = new Float32Array(ANGN);\n  const dropLut = new Uint8Array(128);\n  let cWash, cCore, cFresh, cGrain;\n  let fb = null, lastBuf = null, out = null;\n  let ph1 = 0, ph2 = 0, wk = 0, lastPulse = 0, clock = 0, frame = 0, nextDrop = 40, primed = false;\n  let drops = [];\n  const R = rng(20261106);\n\n  function splat(acc, x, y, a) {\n    const x0 = Math.floor(x), y0 = Math.floor(y), fx = x - x0, fy = y - y0;\n    if (x0 < 0 || y0 < 0 || x0 >= W - 1 || y0 >= H - 1) return;\n    const i = y0 * W + x0;\n    acc[i] += a * (1 - fx) * (1 - fy);\n    acc[i + 1] += a * fx * (1 - fy);\n    acc[i + W] += a * (1 - fx) * fy;\n    acc[i + W + 1] += a * fx * fy;\n  }\n\n  // one row of the ink field; its own function so the engine optimises it early\n  function fieldRow(y, c) {\n    const LA = c.LA, LB = c.LB, gAv = LA.g, gBv = LB.g, ixA = LA.ix, fxA = LA.fx, ixB = LB.ix, fxB = LB.fx, dx4 = c.dx4, brU = c.brU, tlU = c.tlU, trU = c.trU;\n    const rimU = c.rimU, axs = c.axs, sx = c.sx, inv = c.inv, grp = y % GROUPS, list = c.gl[grp];\n    const sl = spanLo[y], sh = spanHi[y], dy4 = c.dy4[y], brV = c.brV[y] * 0.5, tlV = c.tlV[y] * 0.42, trV = c.trV[y] * 0.1, rimV = c.rimV[y];\n    const vy = y / (H - 1) - 0.5, ay = vy < 0 ? -vy : vy, row = y * W;\n    const qa = y / LA.cell, ja = qa | 0, qb = y / LB.cell, jb = qb | 0;\n    let fya = qa - ja, fyb = qb - jb;\n    fya = fya * fya * (3 - 2 * fya);\n    fyb = fyb * fyb * (3 - 2 * fyb);\n    const a0 = ja * LA.gw, a1 = a0 + LA.gw, b0 = jb * LB.gw, b1 = b0 + LB.gw;\n    let lo = c.lo, hi = c.hi, cnt = c.gc[grp];\n    for (let x = 0; x < W; x++) {\n      if (x === sl && sh > sl) { x = sh - 1; continue; }\n      const i = row + x, d4 = dx4[x] + dy4;\n      let e = 0;\n      if (d4 > T4) {\n        let t = (Math.sqrt(Math.sqrt(d4)) - 0.55) / 0.7;\n        if (t > 1) t = 1;\n        e = t * t * (3 - 2 * t);\n      }\n      const xa = ixA[x], fa = fxA[x], xb = ixB[x], fb2 = fxB[x];\n      const ta = gAv[a0 + xa] + (gAv[a0 + xa + 1] - gAv[a0 + xa]) * fa, ba = gAv[a1 + xa] + (gAv[a1 + xa + 1] - gAv[a1 + xa]) * fa;\n      const tb = gBv[b0 + xb] + (gBv[b0 + xb + 1] - gBv[b0 + xb]) * fb2, bb = gBv[b1 + xb] + (gBv[b1 + xb + 1] - gBv[b1 + xb]) * fb2;\n      const n = (ta + (ba - ta) * fya) * inv, fn = tb + (bb - tb) * fyb;\n      const p = e * 0.68 + brU[x] * brV + tlU[x] * tlV + trU[x] * trV + (n - 0.5) * 1.1 + (fn - 0.5) * 0.03;\n      Pq[i] = p * PS;\n      if (p < lo) lo = p;\n      if (p > hi) hi = p;\n      // cheap atan2, only used to pick one of ANGN angle buckets\n      const ax = axs[x], mn = ax < ay ? ax : ay, mx = ax < ay ? ay : ax;\n      const q = mn / (mx + 1e-9), q2 = q * q;\n      let r = ((-0.0464964749 * q2 + 0.15931422) * q2 - 0.327622764) * q2 * q + q;\n      if (ay > ax) r = 1.5707963 - r;\n      if (sx[x] < 0) r = 3.1415927 - r;\n      if (vy < 0) r = TAU - r;\n      const k = (r * (ANGN / TAU)) | 0;\n      ang[i] = k >= ANGN ? ANGN - 1 : k;\n      // soft mottling of the sheet, deeper toward the worn rim\n      gA[i] = e * (4 + 13 * fn + 10 * n) + (rimU[x] > rimV ? rimU[x] : rimV) * 22;\n      mask[i] = 1;\n      list[cnt++] = i;\n    }\n    c.lo = lo;\n    c.hi = hi;\n    c.gc[grp] = cnt;\n  }\n\n  function build() {\n    const rand = rng(1931);\n    // the grain field: four broad octaves are folded onto the lattice of the\n    // fifth, so each pixel needs only two lookups (that one, plus the fibre grain)\n    const cells = [118 * SC, 61 * SC, 31 * SC, 15.5 * SC], amps = [0.5, 0.26, 0.13, 0.065], ampA = 0.045;\n    const coarse = cells.map((c) => lattice(c, rand));\n    const LA = lattice(7.7 * SC, rand), LB = lattice(2.1 * SC, rand);\n    for (let gy = 0; gy < LA.gh; gy++) {\n      for (let gx = 0; gx < LA.gw; gx++) {\n        const k = gy * LA.gw + gx, px = Math.min(gx * LA.cell, W - 1), py = Math.min(gy * LA.cell, H - 1);\n        let v = LA.g[k] * ampA;\n        for (let o = 0; o < coarse.length; o++) v += sample(coarse[o], px, py) * amps[o];\n        LA.g[k] = v;\n      }\n    }\n    const sumA = amps.reduce((a, b) => a + b, 0) + ampA;\n    // separable pieces of the field, per column and per row\n    const dx4 = new Float32Array(W), brU = new Float32Array(W), tlU = new Float32Array(W), trU = new Float32Array(W), rimU = new Float32Array(W);\n    const dy4 = new Float32Array(H), brV = new Float32Array(H), tlV = new Float32Array(H), trV = new Float32Array(H), rimV = new Float32Array(H);\n    for (let x = 0; x < W; x++) {\n      const u = x / (W - 1), dx = Math.abs(u - 0.5) * 2;\n      dx4[x] = dx * dx * dx * dx;\n      brU[x] = Math.exp(-(((u - 1) * 1.6) ** 2) / 0.14);\n      tlU[x] = Math.exp(-((u * 1.6) ** 2) / 0.09);\n      trU[x] = Math.exp(-(((u - 1) * 1.6) ** 2) / 0.05);\n      rimU[x] = ss(0.86, 1.0, dx);\n    }\n    for (let y = 0; y < H; y++) {\n      const v = y / (H - 1), dy = Math.abs(v - 0.5) * 2, dys = dy * 0.9;\n      dy4[y] = dys * dys * dys * dys;\n      brV[y] = Math.exp(-(((v - 1) * 1.1) ** 2) / 0.14);\n      tlV[y] = Math.exp(-((v * 1.1) ** 2) / 0.09);\n      trV[y] = Math.exp(-((v * 1.1) ** 2) / 0.05);\n      rimV[y] = ss(0.86, 1.0, dy);\n    }\n    const axs = new Float32Array(W), sx = new Float32Array(W);\n    for (let x = 0; x < W; x++) {\n      sx[x] = (x / (W - 1) - 0.5) * 1.6;\n      axs[x] = Math.abs(sx[x]);\n    }\n    gA = new Uint8ClampedArray(N);\n    gPix = new Uint32Array(N);\n    Pq = new Float32Array(N);\n    ang = new Uint16Array(N);\n    mask = new Uint8Array(N);\n    const gl = [], gc = new Int32Array(GROUPS);\n    for (let g = 0; g < GROUPS; g++) gl.push(new Int32Array(Math.ceil(H / GROUPS) * W));\n    const c = { LA, LB, dx4, brU, tlU, trU, rimU, axs, sx, dy4, brV, tlV, trV, rimV, gl, gc, inv: 1 / sumA, lo: 1e9, hi: -1e9 };\n    for (let y = 0; y < H; y++) fieldRow(y, c);\n    const lo = c.lo, hi = c.hi;\n    // loose fibres and small inclusions out in the margins, anti-aliased\n    for (let f = 0; f < 110; f++) {\n      const u = rand(), v = rand(), e = edge(u, v);\n      if (e < 0.15 + rand() * 0.55) { f--; continue; }\n      const th = rand() * TAU, len = (4 + rand() * 9) * SC, bend = (rand() - 0.5) * 0.8;\n      const x = u * W, y = v * H, steps = Math.ceil(len * 2), a = 9 + rand() * 12;\n      for (let k = 0; k <= steps; k++) {\n        const t = k / steps, ang2 = th + bend * (t - 0.5);\n        splat(gA, x + Math.cos(ang2) * len * t, y + Math.sin(ang2) * len * t, a * Math.sin(Math.PI * (0.1 + 0.8 * t)));\n      }\n    }\n    for (let s = 0; s < 70; s++) {\n      const u = rand(), v = rand();\n      if (edge(u, v) < 0.25 + rand() * 0.5) { s--; continue; }\n      const x = u * W, y = v * H, a = 50 + rand() * 60;\n      splat(gA, x, y, a);\n      if (rand() < 0.4) splat(gA, x + 0.7, y + 0.4, a * 0.6);\n    }\n    let total = 0;\n    for (let g = 0; g < GROUPS; g++) total += gc[g];\n    act = new Int32Array(total);\n    groupAt = [0];\n    for (let g = 0, at = 0; g < GROUPS; g++) {\n      act.set(gl[g].subarray(0, gc[g]), at);\n      at += gc[g];\n      groupAt.push(at);\n    }\n    const levelMin = L0 - BREATH - WKL, levelMax = L0 + BREATH;\n    smin = lo - OFFA - OFFB - levelMax - 0.01;\n    LUTN = Math.ceil((hi + OFFA + OFFB - levelMin + 0.01 - smin) * PS) + 2;\n    lutA = new Uint8Array(LUTN);\n    lutPix = new Uint32Array(LUTN);\n    // with Pq = p * PS, j = Pq + offq lands on (s - smin) * PS\n    offBase = -smin * PS;\n  }\n\n  function colors(pal) {\n    const fg = pick(pal, [\"foreground\"], [42, 36, 32]);\n    const blue = pick(pal, [\"info\"], [47, 85, 119]);\n    cCore = mix(fg, [74, 50, 32], 0.25);\n    cWash = mix(fg, [140, 90, 45], 0.65);\n    cFresh = mix(blue, [16, 22, 40], 0.4);\n    cGrain = mix(fg, [150, 108, 62], 0.65);\n    for (let n = 0; n < act.length; n++) {\n      const i = act[n];\n      gPix[i] = pack(cGrain[0] | 0, cGrain[1] | 0, cGrain[2] | 0, gA[i]);\n    }\n    // wash shape as a function of s, the distance past the wet