    "script": "// Sea Glass: sunlight shimmering through shallow water onto a sandy floor,\n// with worn pieces of sea glass resting at the edges. Agents at work quicken\n// the water; a finished turn sends a ripple across it. Motion adds up dt.\nlet W = 0, H = 0, base, edge, phase = -1, busy = 0, ripple = null, lastPulse = 1e9, fish = null, nextFish = 0;\nconst SIN = new Float32Array(1024);\nfor (let i = 0; i < 1024; i++) SIN[i] = Math.sin((i / 1024) * Math.PI * 2);\nconst GLASS = [[168, 210, 180], [158, 210, 214], [234, 242, 240], [212, 182, 132], [152, 176, 214], [184, 220, 202], [234, 242, 240]];\nfunction hash(a, b) { const h = Math.sin(a * 127.1 + b * 311.7) * 43758.5453; return h - Math.floor(h); }\nfunction pack(r, g, b) { return 0xff000000 | (Math.max(0, Math.min(255, b | 0)) << 16) | (Math.max(0, Math.min(255, g | 0)) << 8) | Math.max(0, Math.min(255, r | 0)); }\nfunction blend(x, y, c, a) {\n  x |= 0; y |= 0;\n  if (x < 0 || y < 0 || x >= W || y >= H || a <= 0) return;\n  const i = y * W + x, v = base[i];\n  const r = v & 255, g = (v >> 8) & 255, b = (v >> 16) & 255;\n  base[i] = pack(r + (c[0] - r) * a, g + (c[1] - g) * a, b + (c[2] - b) * a);\n}\n// A worn, rounded piece of glass: a soft ellipse with a pale rim and a highlight.\nfunction piece(cx, cy, rx, ry, turn, c) {\n  const R = Math.ceil(Math.max(rx, ry)) + 1, ct = Math.cos(turn), st = Math.sin(turn);\n  for (let dy = -R; dy <= R; dy++) for (let dx = -R; dx <= R; dx++) {\n    const u = (dx * ct + dy * st) / rx, v = (-dx * st + dy * ct) / ry, d = u * u + v * v;\n    if (d > 1.15) continue;\n    const a = Math.min(1, (1.15 - d) * 4) * 0.82;\n    blend(cx + dx, cy + dy, [c[0] - 25 * d, c[1] - 20 * d, c[2] - 18 * d], a);\n    if (d > 0.7) blend(cx + dx, cy + dy, [250, 252, 250], 0.25);\n  }\n  blend(cx - rx * 0.35, cy - ry * 0.4, [255, 255, 255], 0.8);\n  blend(cx - rx * 0.35 + 1, cy - ry * 0.4, [255, 255, 255], 0.5);\n  // Its shadow on the sand, down and to the right.\n  for (let dx = -R; dx <= R; dx++) blend(cx + dx + 1, cy + ry + 1, [170, 160, 132], 0.18 * (1 - Math.abs(dx) / (R + 1)));\n}\n\nthreadlines.backdrop({\n  mode: \"pixels\",\n  scale: 4,\n  smooth: true,\n  setup(info) {\n    W = info.cols; H = info.rows;\n    base = new Uint32Array(W * H);\n    edge = new Float32Array(W);\n    const top = [160, 214, 212], mid = [184, 224, 216], low = [224, 214, 186];\n    for (let y = 0; y < H; y++) {\n      const v = y / H;\n      const a = v < 0.55 ? top : mid, b = v < 0.55 ? mid : low, k = v < 0.55 ? v / 0.55 : (v - 0.55) / 0.45;\n      for (let x = 0; x < W; x++) {\n        // Sand ripples on the floor, faint.\n        const ridge = Math.sin(x * 0.21 + Math.sin(y * 0.09) * 2.4 + y * 0.05) * 3 * k;\n        const f = (hash(x, y) - 0.5) * 4 + ridge;\n        base[y * W + x] = pack(a[0] + (b[0] - a[0]) * k + f, a[1] + (b[1] - a[1]) * k + f, a[2] + (b[2] - a[2]) * k + f);\n      }\n    }\n    // Sea glass, gathered in the lower corners and a few strays along the edges.\n    const unit = Math.min(W, H) / 225;\n    for (let n = 0; n < 30; n++) {\n      const side = n % 2 === 0 ? 0 : 1;\n      const spread = Math.pow(hash(n, 1), 1.6);\n      const x = side === 0 ? spread * W * 0.24 : W - spread * W * 0.24;\n      const y = H * (0.55 + 0.45 * Math.pow(hash(n, 2), 0.6));\n      const size = (2 + hash(n, 3) * 2.6) * unit;\n      piece(x, y, size, size * (0.55 + hash(n, 4) * 0.35), hash(n, 5) * 3.14, GLASS[Math.floor(hash(n, 6) * GLASS.length)]);\n    }\n    // The middle, where the reading column sits, shimmers less.\n    for (let x = 0; x < W; x++) edge[x] = 0.4 + 0.6 * Math.min(1, Math.abs(x / W - 0.5) / 0.3);\n  },\n  draw(pixels, info) {\n    const dt = info.dt, state = info.state;\n    const data = pixels.data;\n    pixels.u32.set(base);\n    busy += ((state.working > 0 ? 1 : 0) - busy) * Math.min(1, dt * 1.5);\n    if (phase < 0) phase = info.t + 30;\n    phase += dt * (1 + 0.6 * busy);\n    const p1 = (phase * 38) | 0, p2 = (phase * 29) | 0, p3 = (phase * 21) | 0;\n    // Caustics: where three slow waves cancel, a thin bright line. Worked\n    // out on every other pixel each way, each value lighting a 2x2 block.\n    for (let y = 0; y < H; y += 2) {\n      const depth = 1 - (y / H) * 0.4;\n      const ry = (y * 5) | 0, ry2 = (y * 3) | 0;\n      for (let x = 0; x < W; x += 2) {\n        const v = SIN[(x * 4 + p1 + SIN[(ry2 + p3) & 1023] * 48) & 1023] + SIN[(ry - p2 + x * 2) & 1023] + SIN[(x * 3 + ry2 + p3) & 1023];\n        let c = 1 - Math.abs(v) * 1.7;\n        if (c <= 0) continue;\n        c = c * c * 0.62 * depth * edge[x];\n        for (let dy = 0; dy < 2 && y + dy < H; dy++) for (let dx = 0; dx < 2 && x + dx < W; dx++) {\n          const o = ((y + dy) * W + x + dx) * 4;\n          data[o] += (255 - data[o]) * c; data[o + 1] += (255 - data[o + 1]) * c; data[o + 2] += (248 - data[o + 2]) * c;\n        }\n      }\n    }\n    // A finished turn sends a ripple out from one side.\n    if (state.sincePulse < lastPulse && state.sincePulse < 0.5) {\n      ripple = { x: (hash(info.frame, 1) < 0.5 ? 0.15 : 0.85) * W, y: (0.3 + hash(info.frame, 2) * 0.4) * H, age: 0 };\n    }\n    lastPulse = state.sincePulse;\n    if (ripple) {\n      ripple.age += dt;\n      const r = ripple.age * W * 0.22, life = Math.max(0, 1 - ripple.age / 2.4);\n      if (life <= 0) ripple = null;\n      else {\n        const steps = Math.ceil(r * 6.3);\n        for (let s = 0; s < steps; s++) {\n          const a = (s / steps) * 6.283, x = (ripple.x + Math.cos(a) * r) | 0, y = (ripple.y + Math.sin(a) * r * 0.6) | 0;\n          if (x < 0 || y < 0 || x >= W || y >= H) continue;\n          const o = (y * W + x) * 4, k = 0.45 * life * edge[x];\n          data[o] += (255 - data[o]) * k; data[o + 1] += (255 - data[o + 1]) * k; data[o + 2] += (255 - data[o + 2]) * k;\n        }\n      }\n    }\n    // Now and then, a small fish's shadow crosses the floor near an edge.\n    if (!fish && info.t > nextFish) {\n      const left = hash(info.frame, 7) < 0.5;\n      fish = { x: left ? -6 : W + 6, y: H * (0.65 + hash(info.frame, 8) * 0.25), v: (left ? 1 : -1) * (14 + hash(info.frame, 9) * 8), side: left };\n    }\n    if (fish) {\n      fish.x += fish.v * dt;\n      if ((fish.v > 0 && fish.x > W * 0.3) || (fish.v < 0 && fish.x < W * 0.7)) { fish = null; nextFish = info.t + 18 + hash(info.frame, 3) * 25; }\n      else {\n        // A soft oval shadow with a tail, swaying a little as it swims.\n        const dir = Math.sign(fish.v), sway = Math.sin(info.t * 5) * 0.6;\n        for (let dy = -3; dy <= 3; dy++) for (let dx = -7; dx <= 5; dx++) {\n          const body = (dx * dx) / 30 + (dy * dy) / 4.5;\n          const tail = dx < -4 ? Math.abs(dy - sway) < (-dx - 4) * 0.7 : false;\n          if (body > 1 && !tail) continue;\n          const x = (fish.x + dx * dir) | 0, y = (fish.y + dy) | 0;\n          if (x < 0 || y < 0 || x >= W || y >= H) continue;\n          const o = (y * W + x) * 4, k = 1 - 0.14 * (tail ? 0.6 : 1 - body * 0.5);\n          data[o] *= k; data[o + 1] *= k; data[o + 2] *= k;\n        }\n      }\n    }\n  },\n});\n",
    "maxFps": 24,
    "still": "data:image/png;base64,"
  },
