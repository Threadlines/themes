    "mode": "pixels",
    "script": "// Morning Fog: layered pale ridges fading into the distance under a soft\n// morning sun, with bands of fog drifting slowly through the valleys between\n// them. Now and then a few birds cross the sky. Agents at work stir the fog;\n// a finished turn thins it for a moment. Motion adds up speed x dt.\nlet W = 0, H = 0, base, band, edge, phase = -1, busy = 0, blow = 0, birds = null, nextBirds = 8;\nconst SIN = new Float32Array(1024);\nfor (let i = 0; i < 1024; i++) SIN[i] = Math.sin((i / 1024) * Math.PI * 2);\nconst RIDGES = [\n  { y: 0.5, amp: 0.05, f: 1.7, o: 0.3, c: [214, 220, 233] },\n  { y: 0.58, amp: 0.06, f: 2.4, o: 1.9, c: [196, 205, 223] },\n  { y: 0.67, amp: 0.06, f: 3.1, o: 4.2, c: [176, 189, 210] },\n  { y: 0.77, amp: 0.055, f: 3.9, o: 2.7, c: [154, 170, 196] },\n  { y: 0.88, amp: 0.05, f: 4.8, o: 5.1, c: [134, 152, 182] },\n];\nfunction hash(a, b) { const h = Math.sin(a * 127.1 + b * 311.7) * 43758.5453; return h - Math.floor(h); }\nfunction pack(r, g, b) { return 0xff000000 | (Math.max(0, Math.min(255, b | 0)) << 16) | (Math.max(0, Math.min(255, g | 0)) << 8) | Math.max(0, Math.min(255, r | 0)); }\nfunction ridgeAt(r, fx) { return r.y + r.amp * Math.sin(fx * r.f * 3.14 + r.o) + r.amp * 0.45 * Math.sin(fx * r.f * 7.1 + r.o * 2.3) + r.amp * 0.18 * Math.sin(fx * 31 + r.o); }\n\nthreadlines.backdrop({\n  mode: \"pixels\",\n  scale: 4,\n  smooth: true,\n  setup(info) {\n    W = info.cols; H = info.rows;\n    base = new Uint32Array(W * H);\n    band = new Float32Array(H);\n    edge = new Float32Array(W);\n    const sunX = W * 0.78, sunY = H * 0.24, radius = Math.min(W, H) * 0.5;\n    for (let y = 0; y < H; y++) {\n      const v = y / H;\n      for (let x = 0; x < W; x++) {\n        // Sky: pale blue above, warm near the sun and the horizon.\n        let r = 226 + 18 * v, g = 233 + 10 * v, b = 246 - 4 * v;\n        const d = Math.hypot(x - sunX, (y - sunY) * 1.2) / radius, glow = Math.max(0, 1 - d);\n        r += (255 - r) * glow * glow * 0.85; g += (247 - g) * glow * glow * 0.75; b += (232 - b) * glow * glow * 0.6;\n        const f = (hash(x, y) - 0.5) * 1.6;\n        base[y * W + x] = pack(r + f, g + f, b + f);\n      }\n    }\n    // Ridges from far to near, each crest softened, each layer hazier at its top.\n    for (const ridge of RIDGES) {\n      for (let x = 0; x < W; x++) {\n        const top = H * ridgeAt(ridge, x / W);\n        for (let y = Math.max(0, Math.floor(top)); y < H; y++) {\n          const cover = y === Math.floor(top) ? 1 - (top - Math.floor(top)) : 1;\n          const haze = Math.max(0, 1 - (y - top) / (H * 0.08)) * 0.35;\n          const i = y * W + x, v = base[i], r0 = v & 255, g0 = (v >> 8) & 255, b0 = (v >> 16) & 255;\n          const c = [ridge.c[0] + (240 - ridge.c[0]) * haze, ridge.c[1] + (243 - ridge.c[1]) * haze, ridge.c[2] + (248 - ridge.c[2]) * haze];\n          const f = (hash(x, y + 5) - 0.5) * 2;\n          base[i] = pack(r0 + (c[0] + f - r0) * cover, g0 + (c[1] + f - g0) * cover, b0 + (c[2] + f - b0) * cover);\n        }\n      }\n    }\n    // Where fog lies: in the valleys just above each ridge after the first.\n    for (let y = 0; y < H; y++) {\n      const v = y / H;\n      let s = 0;\n      for (let k = 1; k < RIDGES.length; k++) {\n        const d = (v - (RIDGES[k].y - RIDGES[k].amp * 0.4)) / 0.045;\n        s += Math.exp(-d * d) * (0.55 + k * 0.08);\n      }\n      band[y] = Math.min(1, s);\n    }\n    for (let x = 0; x < W; x++) edge[x] = 0.55 + 0.45 * Math.min(1, Math.abs(x / W - 0.5) / 0.3);\n  },\n  draw(pixels, info) {\n    const dt = info.dt, state = info.state;\n    const data = pixels.data;\n    pixels.u32.set(base);\n    busy += ((state.working > 0 ? 1 : 0) - busy) * Math.min(1, dt * 1.5);\n    blow += (state.pulse - blow) * Math.min(1, dt * 3);\n    if (phase < 0) phase = info.t + 50;\n    phase += dt * (1 + 0.7 * busy);\n    const thin = 1 - 0.45 * blow;\n    // Fog: soft drifting billows, worked out on every other pixel each way.\n    for (let y = 0; y < H; y += 2) {\n      const density = band[y];\n      if (density < 0.03) continue;\n      const layer = y / H;\n      const speed = 6 + layer * 14;\n      const shift = (phase * speed) | 0;\n      const ry = (y * 3) | 0;\n      for (let x = 0; x < W; x += 2) {\n        const n = SIN[(x * 3 + shift) & 1023] * 0.5 + SIN[(x * 7 - (shift >> 1) + ry) & 1023] * 0.3 + SIN[(x * 13 + shift * 2 + ry * 2) & 1023] * 0.2;\n        const a = density * (0.55 + 0.45 * n) * 0.72 * thin * edge[x];\n        if (a <= 0.01) continue;\n        for (let dy = 0; dy < 2 && y + dy < H; dy++) for (let dx = 0; dx < 2 && x + dx < W; dx++) {\n          const o = ((y + dy) * W + x + dx) * 4;\n          data[o] += (246 - data[o]) * a; data[o + 1] += (248 - data[o + 1]) * a; data[o + 2] += (252 - data[o + 2]) * a;\n        }\n      }\n    }\n    // Now and then a few birds cross the upper sky, near an edge.\n    if (!birds && info.t > nextBirds) {\n      const left = hash(info.frame, 1) < 0.5;\n      birds = { x: left ? -10 : W + 10, y: H * (0.1 + hash(info.frame, 2) * 0.15), v: (left ? 1 : -1) * (10 + hash(info.frame, 3) * 6), flap: 0 };\n    }\n    if (birds) {\n      birds.x += birds.v * dt;\n      birds.flap += dt * 7;\n      const gone = birds.v > 0 ? birds.x > W * 0.32 : birds.x < W * 0.68;\n      if (gone) { birds = null; nextBirds = info.t + 25 + hash(info.frame, 4) * 30; }\n      else {\n        for (let k = 0; k < 3; k++) {\n          const bx = birds.x - Math.sign(birds.v) * k * 7, by = birds.y + k * 3 + Math.sin(birds.flap + k) * 0.6, wing = Math.sin(birds.flap + k * 1.3) > 0 ? 1 : 0;\n          for (const [dx, dy] of [[0, 0], [-1, -1 - wing], [1, -1 - wing], [-2, -1 - wing * 2], [2, -1 - wing * 2]]) {\n            const x = (bx + dx) | 0, y = (by + dy) | 0;\n            if (x < 0 || y < 0 || x >= W || y >= H) continue;\n            const o = (y * W + x) * 4;\n            data[o] += (92 - data[o]) * 0.7; data[o + 1] += (100 - data[o + 1]) * 0.7; data[o + 2] += (118 - data[o + 2]) * 0.7;\n          }\n        }\n      }\n    }\n  },\n});\n",
    "maxFps": 24,
    "still": "data:image/png;base64,"
  },
