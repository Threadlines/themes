    "script": "let scene=null;let flakes=[],lights=[],phase=0,energy=0;\nthreadlines.backdrop({mode:\"canvas\",context:\"2d\",\nsetup(info){ scene=null; flakes=[]; lights=[]; for(let i=0;i<95;i++) flakes.push({x:Math.random(),y:Math.random(),r:0.7+Math.random()*1.8,s:9+Math.random()*19,d:Math.random()*6.28}); for(let i=0;i<42;i++){let v=(i+1)/43;lights.push({v,x:Math.sin(i*2.4)*(.15+v*.32),red:i%3===0});}},\ndraw(ctx,info){let w=info.width,h=info.height,dt=Math.min(info.dt||0,.1);energy+=(Math.min(info.state.working,1)-energy)*Math.min(dt*2,1);phase+=dt*(.65+energy*.2);\nlet target=ctx;if(!scene){scene=new OffscreenCanvas(w,h);ctx=scene.getContext(\"2d\");let sky=ctx.createLinearGradient(0,0,0,h);sky.addColorStop(0,\"#071816\");sky.addColorStop(.65,\"#102d29\");sky.addColorStop(1,\"#24443b\");ctx.fillStyle=sky;ctx.fillRect(0,0,w,h);\nlet phone=w<650, th=phone?Math.min(h*.30,255):Math.min(h*.60,520),tx=phone?w*.64:w*.88,base=phone?h*.76:h*.94,tw=th*.61;\nlet halo=ctx.createRadialGradient(tx,base-th*.45,0,tx,base-th*.45,th*.9);halo.addColorStop(0,\"#47684a44\");halo.addColorStop(1,\"#24443b00\");ctx.fillStyle=halo;ctx.fillRect(tx-th,base-th*1.4,th*2,th*1.5);\nctx.fillStyle=\"#9fbcb31a\";ctx.beginPath();ctx.ellipse(w*.5,h+12,w*.8,h*.09,0,0,Math.PI*2);ctx.fill();\nctx.fillStyle=\"#624c35\";ctx.fillRect(tx-tw*.035,base-th*.12,tw*.07,th*.15);\nfor(let k=0;k<5;k++){let top=base-th+k*th*.145,bot=top+th*(.36+k*.022),half=tw*(.23+k*.09);ctx.beginPath();ctx.moveTo(tx,top);ctx.quadraticCurveTo(tx-half*.55,bot-th*.08,tx-half,bot);ctx.quadraticCurveTo(tx,bot+th*.03,tx+half,bot);ctx.quadraticCurveTo(tx+half*.55,bot-th*.08,tx,top);ctx.fillStyle=k%2?\"#1d5941\":\"#246649\";ctx.fill();ctx.strokeStyle=\"#bad6c044\";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(tx-half,bot);ctx.quadraticCurveTo(tx,bot+th*.03,tx+half,bot);ctx.stroke();}\nfor(let l of lights){let y=base-th+th*(.16+l.v*.76),x=tx+l.x*tw;let glow=.7+.2*Math.sin(phase+l.v*14)+info.state.pulse*.1;ctx.globalAlpha=glow;ctx.fillStyle=l.red?\"#e28d7b\":\"#f1ce83\";ctx.beginPath();ctx.arc(x,y,phone?1.8:2.6,0,7);ctx.fill();ctx.globalAlpha=.12*glow;ctx.beginPath();ctx.arc(x,y,phone?5:9,0,7);ctx.fill();}ctx.globalAlpha=1;\nctx.save();ctx.translate(tx,base-th-5);ctx.fillStyle=\"#f6d990\";ctx.shadowColor=\"#f0bf5d\";ctx.shadowBlur=14;ctx.beginPath();for(let i=0;i<10;i++){let a=-Math.PI/2+i*Math.PI/5,r=i%2?4:10;ctx.lineTo(Math.cos(a)*r,Math.sin(a)*r);}ctx.closePath();ctx.fill();ctx.restore();}ctx=target;ctx.drawImage(scene,0,0);\nfor(let f of flakes){f.y+=f.s*(1+energy*.12)*dt/h;f.x+=Math.sin(phase*.3+f.d)*dt*2/w;if(f.y>1.02){f.y=-.02;f.x=Math.random();}ctx.globalAlpha=.28+f.r*.16;ctx.fillStyle=\"#edf5ed\";ctx.beginPath();ctx.arc(f.x*w,f.y*h,f.r,0,7);ctx.fill();}ctx.globalAlpha=1;\n}});",
