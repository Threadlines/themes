    "script": "const W = 320, H = 200, TAU = Math.PI * 2;\nconst SUNX = 236, SUNY = 147, SUNR = 19;\nconst MOONX = 92, MOONY = 24;\nconst BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + 0.5) / 16);\nfunction hx(c) { return [parseInt(c.slice(1, 3), 16), parseInt(c.slice(3, 5), 16), parseInt(c.slice(5, 7), 16)]; }\nfunction rng(s) { return function () { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nfunction hash(n) { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); }\nfunction mixc(a, b, k) { return [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k]; }\n\nconst SKY = ['#0d0a20', '#151132', '#1f1645', '#2c1b55', '#3f215e', '#572864', '#733068', '#933a66', '#b2475f', '#cf5a55', '#e6744a', '#f49547', '#fbb757', '#ffd77e'].map(hx);\nconst C = {\n  hill: hx('#4c2a60'), hillLow: hx('#3a2050'), hillTop: hx('#6e3468'), far: hx('#37204f'), mid: hx('#231740'), near: hx('#0f0b1d'),\n  rimMid: hx('#5c2c58'), rimNear: hx('#3a1c3c'), fog: hx('#55306a'),\n  sun0: hx('#fff3c2'), sun1: hx('#ffe08e'), sun2: hx('#ffbf66'), halo: hx('#ffd77e'),\n  moon: hx('#ffeccb'), moonShade: hx('#cdb7a0'), star: hx('#fff3d2'),\n  cTop: hx('#4e2760'), cBody: hx('#7e3768'), cLit: hx('#f0856a'),\n  flyCore: hx('#f6ff9e'), flyGlow: hx('#bfe85e'), owl: hx('#ffd447'),\n};\n\nlet base = null, lay, stars, clouds, flies, owl, clock = 0;\n\nfunction fill(L, x0, x1, y) {\n  if (x0 < 0) x0 = 0; if (x1 > W - 1) x1 = W - 1;\n  const row = y * W;\n  for (let x = x0; x <= x1; x++) if (lay[row + x] < L) lay[row + x] = L;\n}\n\n// A stepped pixel pine: stacked tiers that each start narrow and flare out.\nfunction pine(L, cx, baseY, h, hw, tiers) {\n  const trunkH = Math.max(2, Math.round(h * 0.1));\n  const ch = h - trunkH, top = baseY - h;\n  const b = 0.55, a = tiers > 1 ? (1 - b) / (tiers - 1) : 0;\n  for (let r = 0; r <= ch; r++) {\n    const y = top + r; if (y < 0 || y >= H) continue;\n    const p = r / (ch + 1) * tiers, tier = Math.floor(p), local = p - tier;\n    let w = Math.round(hw * (tier * a + local * b));\n    if (((r * 7 + cx * 3) % 5 + 5) % 5 === 0 && w > 1) w += 1;\n    fill(L, cx - w, cx + w, y);\n  }\n  const tw = Math.max(1, Math.round(hw * 0.12));\n  for (let y = Math.max(0, top + ch + 1); y < baseY && y < H; y++) fill(L, cx - tw, cx + tw, y);\n}\n\nfunction skyAt(x, y) {\n  const dxs = x - SUNX, dys = y - SUNY, d2 = dxs * dxs + dys * dys;\n  const th = BAYER[(y & 3) * 4 + (x & 3)];\n  if (d2 <= SUNR * SUNR) return y < SUNY - 11 ? C.sun0 : y < SUNY - 3 ? C.sun1 : C.sun2;\n  if (d2 <= (SUNR + 3) * (SUNR + 3) && th < 0.5) return C.halo;\n  const m1 = (x - MOONX) ** 2 + (y - MOONY) ** 2, m2 = (x - MOONX - 3) ** 2 + (y - MOONY + 3) ** 2;\n  if (m1 <= 36 && m2 > 36) return m2 <= 52 ? C.moonShade : C.moon;\n  const yy = Math.min(1, y / 150);\n  const d = Math.sqrt((dxs * 0.7) ** 2 + (dys * 1.5) ** 2);\n  const glow = Math.max(0, 1 - d / 120);\n  let v = Math.pow(yy, 1.7) * 11 + glow * glow * 3;\n  if (v > SKY.length - 1) v = SKY.length - 1;\n  let k = Math.floor(v);\n  if (v - k > th && k < SKY.length - 1) k++;\n  return SKY[k];\n}\n\nfunction makeCloud(cw, ch, blobs) {\n  const m = new Uint8Array(cw * ch), s = new Uint8Array(cw * ch);\n  for (let y = 0; y < ch; y++) for (let x = 0; x < cw; x++)\n    for (const [bx, by, rx, ry] of blobs) { const u = (x - bx) / rx, v = (y - by) / ry; if (u * u + v * v <= 1) { m[y * cw + x] = 1; break; } }\n  for (let y = 0; y < ch; y++) for (let x = 0; x < cw; x++) {\n    if (!m[y * cw + x]) continue;\n    const b1 = y + 1 < ch ? m[(y + 1) * cw + x] : 0, b2 = y + 2 < ch ? m[(y + 2) * cw + x] : 0;\n    const a2 = y > 1 ? m[(y - 2) * cw + x] : 0;\n    s[y * cw + x] = (!b1 || !b2) ? 3 : !a2 ? 1 : 2;\n  }\n  return { cw, ch, s };\n}\n\nfunction setup() {\n  base = new Uint8ClampedArray(W * H * 4);\n  lay = new Uint8Array(W * H);\n  clock = 0;\n  const R = rng(7);\n  const hillY = new Int16Array(W);\n  for (let x = 0; x < W; x++) {\n    hillY[x] = Math.round(141 + 5 * Math.sin(x * TAU * 2 / W + 0.6) + 3 * Math.sin(x * TAU * 5 / W + 2.1) + 1.5 * Math.sin(x * TAU * 11 / W));\n    for (let y = hillY[x]; y < H; y++) lay[y * W + x] = 1;\n  }\n  for (let x = -4; x < W + 4; x += 4 + Math.floor(R() * 5)) {\n    const xi = Math.min(W - 1, Math.max(0, x));\n    pine(2, x, hillY[xi] + 4, 8 + Math.floor(R() * 11), 2 + Math.floor(R() * 3), 2);\n  }\n  for (let x = -6; x < W + 6; x += 7 + Math.floor(R() * 7)) {\n    const calm = 1 - 0.4 * Math.max(0, 1 - Math.abs(x - 160) / 90);\n    const h = Math.round((20 + R() * 26) * calm);\n    pine(3, x, 176 + Math.floor(R() * 5), h, 5 + Math.floor(R() * 4), Math.max(2, Math.round(h / 10)));\n  }\n  for (let x = 0; x < W; x++) {\n    const my = Math.round(178 + 1.5 * Math.sin(x * TAU * 4 / W + 0.8) + Math.sin(x * TAU * 9 / W));\n    for (let y = my; y < H; y++) if (lay[y * W + x] < 3) lay[y * W + x] = 3;\n  }\n  const near = [[6, 170, 26], [38, 126, 18], [86, 106, 14], [318, 178, 28], [288, 132, 19], [258, 84, 12]];\n  for (const [cx, h, hw] of near) pine(4, cx, 201, h, hw, Math.max(3, Math.round(h / 22)));\n  for (let x = 0; x < W; x++) {\n    const gy = Math.round(189 + 2 * Math.sin(x * TAU * 3 / W) + Math.sin(x * TAU * 7 / W + 1));\n    for (let y = gy; y < H; y++) lay[y * W + x] = 4;\n  }\n  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n    const i = y * W + x, o = i * 4, L = lay[i];\n    const th = BAYER[(y & 3) * 4 + (x & 3)];\n    let c;\n    if (L === 0) c = skyAt(x, y);\n    else if (L === 1) c = (y > 0 && lay[i - W] === 0) ? C.hillTop : ((y - 150) / 22 > th ? C.hillLow : C.hill);\n    else if (L === 2) c = C.far;\n    else {\n      const dx = x < SUNX ? 1 : -1, nx = x + dx;\n      const rim = nx >= 0 && nx < W && lay[i + dx] < L;\n      c = L === 3 ? (rim ? C.rimMid : C.mid) : (rim ? C.rimNear : C.near);\n    }\n    if (L >= 1 && L <= 3) {\n      const dens = Math.max(0, 1 - Math.abs(y - 172) / 11) * 0.65;\n      if (dens > th) c = mixc(c, C.fog, 0.55);\n    }\n    base[o] = c[0]; base[o + 1] = c[1]; base[o + 2] = c[2]; base[o + 3] = 255;\n  }\n  stars = [];\n  for (let n = 0; n < 90 && stars.length < 48; n++) {\n    const x = Math.floor(R() * W), y = Math.floor(Math.pow(R(), 1.5) * 88);\n    if (lay[y * W + x] !== 0) continue;\n    if ((x - MOONX) ** 2 + (y - MOONY) ** 2 < 130) continue;\n    stars.push({ x, y, ph: R() * TAU, sp: 0.5 + R() * 1.3, s: 0.9 - y / 110, big: R() < 0.15 });\n  }\n  clouds = [\n    { sp: makeCloud(54, 12, [[9, 9, 8, 3.5], [20, 6, 10, 6], [33, 5, 9, 5], [44, 8, 9, 4]]), y: 50, v: 0.3, x0: 60 },\n    { sp: makeCloud(30, 8, [[7, 6, 6, 2.5], [15, 4, 7, 4], [23, 5, 6, 3]]), y: 30, v: 0.18, x0: 230 },\n    { sp: makeCloud(40, 9, [[8, 7, 7, 3], [19, 4, 9, 5], [31, 6, 8, 3.5]]), y: 78, v: 0.42, x0: 170 },\n  ];\n  flies = [];\n  for (let n = 0; n < 30; n++) {\n    let x = R() * W;\n    if (x > 105 && x < 215 && R() < 0.65) x = R() < 0.5 ? R() * 105 : 215 + R() * 105;\n    const side = x < 95 || x > 230;\n    const y = side ? 112 + R() * 82 : 158 + R() * 36;\n    flies.push({ x, y, ax: 4 + R() * 10, ay: 2 + R() * 4, fx: 0.25 + R() * 0.5, fy: 0.2 + R() * 0.5, ph: R() * TAU, bf: 0.8 + R() * 1.4, bp: R() * TAU });\n  }\n  owl = null;\n  const ox = 297, oy = 140;\n  let ok = true;\n  for (let y = oy - 3; y <= oy + 3; y++) for (let x = ox - 3; x <= ox + 6; x++) if (lay[y * W + x] !== 4) ok = false;\n  if (ok) owl = [(oy * W + ox) * 4, (oy * W + ox + 3) * 4];\n}\n\nfunction blend(px, o, c, a) {\n  if (a > 1) a = 1;\n  px[o] += (c[0] - px[o]) * a; px[o + 1] += (c[1] - px[o + 1]) * a; px[o + 2] += (c[2] - px[o + 2]) * a;\n}\nfunction dot(px, x, y, c, a) {\n  if (y < 0 || y >= H) return;\n  x = ((x % W) + W) % W;\n  blend(px, (y * W + x) * 4, c, a);\n}\n\nfunction draw(pixels, info) {\n  const px = pixels.data || pixels;\n  if (!base) setup();\n  const st = info.state || {};\n  const working = Math.min(2, st.working || 0), pulse = st.pulse || 0;\n  const t = info.t || 0;\n  clock += Math.min(0.25, info.dt || 0) * (1 + 0.35 * working);\n  px.set(base);\n\n  // Stars twinkle, a touch brighter on a pulse.\n  for (let j = 0; j < stars.length; j++) {\n    const s = stars[j];\n    const b = 0.5 + 0.5 * Math.sin(t * s.sp + s.ph);\n    const a = s.s * (0.25 + 0.75 * b) * (1 + 0.3 * pulse);\n    blend(px, (s.y * W + s.x) * 4, C.star, a);\n    if (s.big && b > 0.8) {\n      const g = a * 0.3;\n      if (s.x > 0) blend(px, (s.y * W + s.x - 1) * 4, C.star, g);\n      if (s.x < W - 1) blend(px, (s.y * W + s.x + 1) * 4, C.star, g);\n      if (s.y > 0) blend(px, ((s.y - 1) * W + s.x) * 4, C.star, g);\n      blend(px, ((s.y + 1) * W + s.x) * 4, C.star, g);\n    }\n  }\n\n  // A rare shooting star.\n  const P = 19, k = Math.floor(t / P), s0 = hash(k) * (P - 2), u = (t - k * P - s0) / 0.9;\n  if (hash(k + 0.5) < 0.55 && u >= 0 && u <= 1) {\n    const sx = 20 + hash(k + 1.3) * 280, sy = 6 + hash(k + 2.7) * 36, dir = hash(k + 3.1) < 0.5 ? -1 : 1;\n    const hx0 = sx + dir * u * 42, hy0 = sy + u * 18;\n    for (let j = 0; j < 9; j++) {\n      const x = Math.round(hx0 - dir * j * 1.4), y = Math.round(hy0 - j * 0.6);\n      if (x < 0 || x >= W || y < 0 || y >= H || lay[y * W + x]) continue;\n      blend(px, (y * W + x) * 4, C.star, (1 - j / 9) * (1 - u * 0.5));\n    }\n  }\n\n  // Clouds drift at their own speeds, lit from below by the set sun.\n  for (let j = 0; j < clouds.length; j++) {\n    const c = clouds[j], sp = c.sp, span = W + sp.cw;\n    const ox = Math.floor((((c.x0 - t * c.v) % span) + span) % span) - sp.cw;\n    for (let y = 0; y < sp.ch; y++) {\n      const Y = c.y + y, row = Y * W;\n      for (let x = 0; x < sp.cw; x++) {\n        const v = sp.s[y * sp.cw + x]; if (!v) continue;\n        const X = ox + x; if (X < 0 || X >= W || lay[row + X]) continue;\n        const col = v === 3 ? C.cLit : v === 1 ? C.cTop : C.cBody, o = (row + X) * 4;\n        px[o] = col[0]; px[o + 1] = col[1]; px[o + 2] = col[2];\n      }\n    }\n  }\n\n  // An owl in the big right-hand pine opens its eyes now and then.\n  if (owl) {\n    const m = t % 53;\n    if (m > 12 && m < 34 && (m % 4.3) > 0.2) {\n      for (const o of owl) { px[o] = C.owl[0]; px[o + 1] = C.owl[1]; px[o + 2] = C.owl[2]; }\n    }\n  }\n\n  // Fireflies: more of them, a little quicker, while agents work; all glow on a pulse.\n  const n = Math.min(flies.length, 16 + Math.round(6 * working));\n  for (let j = 0; j < n; j++) {\n    const f = flies[j];\n    let b = Math.sin(clock * f.bf + f.bp);\n    b = b > 0.5 ? (b - 0.5) * 2 : 0;\n    if (pulse > b) b = pulse;\n    if (b <= 0.03) continue;\n    const x = Math.round(f.x + f.ax * Math.sin(clock * f.fx + f.ph));\n    const y = Math.round(f.y + f.ay * Math.sin(clock * f.fy + f.ph * 1.7));\n    dot(px, x, y, C.flyCore, b * 1.3);\n    const g = b * 0.4;\n    dot(px, x + 1, y, C.flyGlow, g); dot(px, x - 1, y, C.flyGlow, g);\n    dot(px, x, y + 1, C.flyGlow, g); dot(px, x, y - 1, C.flyGlow, g);\n  }\n}\n\nthreadlines.backdrop({ mode: 'pixels', width: W, height: H, setup, draw });\n",
